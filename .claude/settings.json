{
    "permissions":  {
                        "allow":  [
                                      "Bash(cat:*)",
                                      "Bash(diff:*)",
                                      "Bash(docker compose build:*)",
                                      "Bash(docker compose down:*)",
                                      "Bash(docker compose exec:*)",
                                      "Bash(docker compose ps:*)",
                                      "Bash(docker compose restart:*)",
                                      "Bash(docker compose up:*)",
                                      "Bash(docker compose version:*)",
                                      "Bash(docker cp:*)",
                                      "Bash(docker logs:*)",
                                      "Bash(docker ps:*)",
                                      "Bash(docker restart:*)",
                                      "Bash(docker run:*)",
                                      "Bash(docker --version:*)",
                                      "Bash(echo:*)",
                                      "Bash(find:*)",
                                      "Bash(git add:*)",
                                      "Bash(git branch:*)",
                                      "Bash(git checkout:*)",
                                      "Bash(git commit:*)",
                                      "Bash(git diff:*)",
                                      "Bash(git fetch:*)",
                                      "Bash(git log:*)",
                                      "Bash(git ls-remote:*)",
                                      "Bash(git rev-parse:*)",
                                      "Bash(git status:*)",
                                      "Bash(git switch:*)",
                                      "Bash(grep:*)",
                                      "Bash(head:*)",
                                      "Bash(ls:*)",
                                      "Bash(mkdir:*)",
                                      "Bash(MSYS_NO_PATHCONV=1 docker run:*)",
                                      "Bash(pwd:*)",
                                      "Bash(sleep:*)",
                                      "Bash(sort:*)",
                                      "Bash(stat:*)",
                                      "Bash(tail:*)",
                                      "Bash(test:*)",
                                      "Bash(tr:*)",
                                      "Bash(wc:*)",
                                      "Edit(**/docker-env/**)",
                                      "Edit(**/static/tests/tours/**)",
                                      "Edit(**/tests/**)",
                                      "Edit(doc-dev/**)",
                                      "Write(**/docker-env/**)",
                                      "Write(**/static/tests/tours/**)",
                                      "Write(**/tests/**)",
                                      "Write(doc-dev/**)"
                                  ],
                        "deny":  [
                                     "Bash(git push:*)",
                                     "Edit(**/controllers/**)",
                                     "Edit(**/data/**)",
                                     "Edit(**/models/**)",
                                     "Edit(**/security/**)",
                                     "Edit(**/views/**)",
                                     "Edit(**/wizard/**)",
                                     "Write(**/controllers/**)",
                                     "Write(**/data/**)",
                                     "Write(**/models/**)",
                                     "Write(**/security/**)",
                                     "Write(**/views/**)",
                                     "Write(**/wizard/**)"
                                 ]
                    },
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "cat \u003e\u003e .claude/backfill-command-log.jsonl"
                                                       }
                                                   ]
                                     }
                                 ]
              }
}
