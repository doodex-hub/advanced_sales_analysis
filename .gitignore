# gitignore.template — migration-tool CLI bootstrap
#
# Instansiasi ke: target-codebase/.gitignore (root repo modul, sibling CLAUDE.md/doc-dev/)
# Menggantikan .gitignore lama warisan doc-dev-backfill (dikonfirmasi dev, lihat CLAUDE.md).

# Python bytecode cache — dihasilkan otomatis begitu Odoo/Python meng-import file modul untuk
# testing (Mode B/C/D), termasuk lewat volume mount docker-env yang tembus balik ke folder host.
__pycache__/
*.pyc
*.pyo

# Log runtime Odoo dari docker-env (Mode B/C/D) — noise operasional per-run, bukan deliverable.
# "**/" WAJIB di depan supaya match walau docker-env nested di dalam folder modul.
**/docker-env/logs/

# Command-log hook Claude Code CLI (lihat templates/cli-config/settings.json.template) — jejak
# operasional sesi CLI, bukan bagian dokumentasi migrasi.
.claude/migration-tool-command-log.jsonl

# Config permission personal (auto-generated saat klik "Always allow" di CLI) — beda dev bisa beda
# preferensi, jangan dipaksa seragam lewat commit bersama.
.claude/settings.local.json
